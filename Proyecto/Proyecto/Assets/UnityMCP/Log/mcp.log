{"ts":"2026-11-16T17:07:36.194Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3140,"action":"execute","params":{"action":"execute","code":"\nvar sb=new System.Text.StringBuilder();\nforeach(UnityEngine.Transform f in GameObject.Find(\"FRUTAS\").transform){\n var gr=f.GetComponent<Oculus.Interaction.Grabbable>();\n var rb=f.GetComponent<UnityEngine.Rigidbody>();\n var near=f.GetComponent<Oculus.Interaction.GrabInteractable>();\n var hand=f.GetComponent<Oculus.Interaction.HandGrab.HandGrabInteractable>();\n var d=f.Find(\"DistanceHandGrabInstallationRoutine\");\n var dg=d==null?null:d.GetComponent<Oculus.Interaction.DistanceGrabInteractable>();\n var dh=d==null?null:d.GetComponent<Oculus.Interaction.HandGrab.DistanceHandGrabInteractable>();\n var p=d==null?null:d.GetComponent<Oculus.Interaction.MoveTowardsTargetProvider>();\n var flags=System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic;\n var refNear=near.GetType().BaseType.GetField(\"_pointableElement\",flags).GetValue(near);\n var refHand=hand.GetType().BaseType.GetField(\"_pointableElement\",flags).GetValue(hand);\n var refFar=dg.GetType().BaseType.GetField(\"_pointableElement\",flags).GetValue(dg);\n var refFarHand=dh.GetType().BaseType.GetField(\"_pointableElement\",flags).GetValue(dh);\n sb.AppendLine(f.name+\" tag=\"+f.tag+\" near/far refs=\"+(refNear==gr)+\"/\"+(refHand==gr)+\"/\"+(refFar==gr)+\"/\"+(refFarHand==gr)+\" sharedProvider=\"+(p!=null&&dg.GetType().GetField(\"_movementProvider\",flags).GetValue(dg)==p&&dh.GetType().GetField(\"_movementProvider\",flags).GetValue(dh)==p));\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}

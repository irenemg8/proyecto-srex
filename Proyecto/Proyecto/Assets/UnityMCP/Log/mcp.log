{"ts":"2026-11-16T19:40:06.465Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3453,"action":"execute","params":{"action":"execute","code":"\nvar sb=new System.Text.StringBuilder();\nAction<UnityEngine.GameObject, System.Type> ensure=(go,type)=>{\n if(go==null){sb.AppendLine(\"missing target for \"+type.Name);return;}\n if(go.GetComponent(type)==null)go.AddComponent(type);\n sb.AppendLine(type.Name+\" -> \"+go.name);\n};\nvar sensor=GameObject.Find(\"SARTEN/SartenSensor\");\nif(sensor!=null){\n var old=sensor.GetComponent<SrexKitchenController>();\n if(old!=null)UnityEngine.Object.DestroyImmediate(old);\n ensure(sensor,typeof(SartenController));\n}\nensure(GameObject.Find(\"Panel_Alimentos\"),typeof(FruitProgressController));\nensure(GameObject.Find(\"INTERFACES\"),typeof(ExitDialogController));\nensure(GameObject.Find(\"Panel_Volumen\"),typeof(AmbientVolumeController));\nensure(GameObject.Find(\"Panel_Locomocion\"),typeof(LocomotionModeController));\nensure(GameObject.Find(\"Toggle_EfectosEspaciales\"),typeof(SpatialEffectsController));\nensure(GameObject.Find(\"ButtonShelf_IconAndLabel_Toggle\"),typeof(HelpDialogController));\n\nUnityEngine.UI.Toggle refresh=null;\nforeach(var t in UnityEngine.Object.FindObjectsOfType<UnityEngine.UI.Toggle>(true)){\n foreach(var label in t.GetComponentsInChildren<TMPro.TMP_Text>(true)){\n  if(label.text.IndexOf(\"Recargar marcador\",System.StringComparison.OrdinalIgnoreCase)>=0){refresh=t;break;}\n }\n if(refresh!=null)break;\n}\nensure(refresh==null?null:refresh.gameObject,typeof(ProgressRefreshButton));\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}

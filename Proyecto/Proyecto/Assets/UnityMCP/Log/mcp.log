{"ts":"2026-11-16T16:26:33.069Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3683,"action":"execute","params":{"action":"execute","code":"\nvar sb=new System.Text.StringBuilder();\nFunc<string,UnityEngine.GameObject> FindSceneObject=name=>System.Array.Find(Resources.FindObjectsOfTypeAll<UnityEngine.GameObject>(),g=>g.name==name&&g.scene.IsValid());\nvar controller=FindSceneObject(\"SartenSensor\").GetComponent<SrexKitchenController>();\nvar spatial=FindSceneObject(\"Toggle_EfectosEspaciales\").GetComponent<UnityEngine.UI.Toggle>();\nvar helpToggle=FindSceneObject(\"ButtonShelf_IconAndLabel_Toggle\").GetComponent<UnityEngine.UI.Toggle>();\nvar slider=FindSceneObject(\"SmallSlider\").GetComponent<UnityEngine.UI.Slider>();\nvar dropdown=FindSceneObject(\"Dropdown\").GetComponent<TMPro.TMP_Dropdown>();\nvar help=FindSceneObject(\"INTERFAZ_DIALOGO\");\nvar ambient=FindSceneObject(\"AudioSource_Ambiente\").GetComponent<UnityEngine.AudioSource>();\nvar wc=FindSceneObject(\"SONIDO_WC\").GetComponentInChildren<UnityEngine.AudioSource>(true);\nvar frying=FindSceneObject(\"SONIDO_FREIR\").GetComponentInChildren<UnityEngine.AudioSource>(true);\nUnityEngine.UI.Toggle refresh=null;\nforeach(var t in UnityEngine.Object.FindObjectsOfType<UnityEngine.UI.Toggle>(true)){\n foreach(var label in t.GetComponentsInChildren<TMPro.TMP_Text>(true))if(label.text.IndexOf(\"Recargar marcador\",System.StringComparison.OrdinalIgnoreCase)>=0)refresh=t;\n}\n\nspatial.isOn=false;\nslider.value=0.37f;\ndropdown.value=3;\nhelpToggle.isOn=false;\nsb.AppendLine(\"actual UI events: effectsMuted=\"+(wc.mute&&frying.mute)+\" ambientVolume=\"+ambient.volume.ToString(\"F2\")+\" helpHidden=\"+!help.activeSelf+\" dropdown=\"+dropdown.value);\ndropdown.value=0;\nhelpToggle.isOn=true;\nspatial.isOn=true;\n\nstring[] fruitNames={\"Banana_01\",\"Banana_02\",\"Orange_01\",\"Orange_02\",\"Pineapple_01\"};\nforeach(string n in fruitNames){\n var fruit=FindSceneObject(n);\n if(fruit!=null)controller.SendMessage(\"OnTriggerEnter\",fruit.GetComponent<UnityEngine.Collider>());\n}\ncontroller.RefreshProgressUI();\nvar banana=FindSceneObject(\"Text_Cantidad\");\nvar recipe1=FindSceneObject(\"Panel_Ingrediente_3\").transform.Find(\"Text_Cantidad\").GetComponent<TMPro.TMP_Text>();\nvar recipe2=FindSceneObject(\"Panel_Ingrediente_2\").transform.Find(\"Text_Cantidad\").GetComponent<TMPro.TMP_Text>();\nvar recipe3=FindSceneObject(\"Panel_Ingrediente_1\").transform.Find(\"Text_Cantidad\").GetComponent<TMPro.TMP_Text>();\nvar state=FindSceneObject(\"Text_Estado\").GetComponent<TMPro.TMP_Text>();\nvar before=recipe1.text+\"/\"+recipe2.text+\"/\"+recipe3.text+\";\"+state.text;\nif(refresh!=null)refresh.isOn=true;\nvar after=recipe1.text+\"/\"+recipe2.text+\"/\"+recipe3.text+\";\"+state.text;\nsb.AppendLine(\"recipe before/after refresh=\"+before+\" / \"+after+\" refreshReset=\"+(refresh==null?\"missing\":(!refresh.isOn).ToString()));\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}

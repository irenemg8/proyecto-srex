{"ts":"2026-11-16T16:31:00.889Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3276,"action":"execute","params":{"action":"execute","code":"\nvar sb=new System.Text.StringBuilder();\nstring[] names={\"SONIDO_WC\",\"SONIDO_SARTEN\",\"SONIDO_FREIR\",\"AudioSource_Ambiente\"};\nforeach(string name in names){\n var go=System.Array.Find(Resources.FindObjectsOfTypeAll<GameObject>(),g=>g.name==name&&g.scene.IsValid());\n if(go==null){sb.AppendLine(name+\": missing\");continue;}\n var src=go.GetComponentInChildren<UnityEngine.AudioSource>(true);\n if(src==null){sb.AppendLine(name+\": AudioSource missing\");continue;}\n sb.AppendLine(name+\" clip=\"+(src.clip==null?\"null\":src.clip.name)+\" spatialize=\"+src.spatialize+\" spatialBlend=\"+src.spatialBlend+\" min=\"+src.minDistance+\" max=\"+src.maxDistance+\" mute=\"+src.mute+\" loop=\"+src.loop+\" playOnAwake=\"+src.playOnAwake);\n}\nforeach(string name in new[]{\"Button_SI\",\"Button_NO\"}){\n var go=System.Array.Find(Resources.FindObjectsOfTypeAll<GameObject>(),g=>g.name==name&&g.scene.IsValid());\n var button=go==null?null:go.GetComponent<UnityEngine.UI.Button>();\n sb.AppendLine(name+\" onClick persistent=\"+(button==null?\"missing\":button.onClick.GetPersistentEventCount().ToString()));\n}\nvar tags=UnityEditorInternal.InternalEditorUtility.tags;\nsb.AppendLine(\"fruitTags=\"+string.Join(\",\",tags));\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}

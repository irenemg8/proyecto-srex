dataProp.GetValue(surf)) : null;\nUnityEditor.SceneManagement.EditorSceneManager.MarkAllScenesDirty();\nreturn \"NavMeshSurface añadido a SUELO_NAV | Collect=Volume | center ~(0, 0, 0.73) size ~(12.5, 0.6, 12.2) | Bake: \" + (data != null ? \"OK\" : \"data nula\");\n","safety_checks":true,"compiler":"auto"},"error":"Compilation failed"}

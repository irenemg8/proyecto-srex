{"ts":"2026-11-16T19:53:02.999Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3619,"action":"execute","params":{"action":"execute","code":"\nFunc<string,UnityEngine.GameObject> FindScene=name=>System.Array.Find(Resources.FindObjectsOfTypeAll<UnityEngine.GameObject>(),g=>g.name==name&&g.scene.IsValid());\nvar effects=FindScene(\"Toggle_EfectosEspaciales\").GetComponent<UnityEngine.UI.Toggle>();\nvar helpToggle=FindScene(\"ButtonShelf_IconAndLabel_Toggle\").GetComponent<UnityEngine.UI.Toggle>();\nvar slider=FindScene(\"SmallSlider\").GetComponent<UnityEngine.UI.Slider>();\nvar dropdown=FindScene(\"Dropdown\").GetComponent<TMPro.TMP_Dropdown>();\nvar help=FindScene(\"INTERFAZ_DIALOGO\");\nvar ambient=FindScene(\"AudioSource_Ambiente\").GetComponent<UnityEngine.AudioSource>();\nvar wc=FindScene(\"SONIDO_WC\").GetComponentInChildren<UnityEngine.AudioSource>(true);\nvar panAudio=FindScene(\"SONIDO_SARTEN\").GetComponentInChildren<UnityEngine.AudioSource>(true);\nvar frying=FindScene(\"SONIDO_FREIR\").GetComponentInChildren<UnityEngine.AudioSource>(true);\nvar moving=FindScene(\"Moving\").GetComponent<Oculus.Interaction.Locomotion.MovingSetting>();\nvar flags=System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic;\nvar slide=(System.Collections.Generic.List<UnityEngine.GameObject>)moving.GetType().GetField(\"_slideGameObjects\",flags).GetValue(moving);\nvar tele=(System.Collections.Generic.List<UnityEngine.GameObject>)moving.GetType().GetField(\"_teleportGameObjects\",flags).GetValue(moving);\neffects.isOn=false;slider.value=0.37f;dropdown.value=3;helpToggle.isOn=false;\nint s=0,t=0;\nforeach(var g in slide)if(g!=null&&g.activeSelf)s++;\nforeach(var g in tele)if(g!=null&&g.activeSelf)t++;\nvar hidden=!help.activeSelf;\nvar off=wc.mute&&panAudio.mute&&frying.mute;\neffects.isOn=true;helpToggle.isOn=true;dropdown.value=0;\nreturn \"effectsMuted=\"+off+\" ambient=\"+ambient.volume.ToString(\"F2\")+\" helpHidden=\"+hidden+\" noneGroups=\"+s+\"/\"+t+\" restoredHelp=\"+help.activeSelf+\" restoredEffects=\"+(!wc.mute&&!panAudio.mute&&!frying.mute);\n","safety_checks":true,"compiler":"codedom"}}

{"ts":"2026-11-16T17:01:48.284Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3213,"action":"execute","params":{"action":"execute","code":"\nvar sb=new System.Text.StringBuilder();\nstring[] paths={\"Assets/_Proyecto/Prefabs/Frutas/Banana_Interactable.prefab\",\"Assets/_Proyecto/Prefabs/Frutas/Orange_Interactable.prefab\",\"Assets/_Proyecto/Prefabs/Frutas/Pineapple_Interactable.prefab\"};\nforeach(string path in paths){\n var root=UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.GameObject>(path);\n var gr=root.GetComponent<Oculus.Interaction.Grabbable>();\n var direct=root.GetComponent<Oculus.Interaction.GrabInteractable>();\n var hand=root.GetComponent<Oculus.Interaction.HandGrab.HandGrabInteractable>();\n var distance=root.GetComponentInChildren<Oculus.Interaction.DistanceGrabInteractable>(true);\n var distanceHand=root.GetComponentInChildren<Oculus.Interaction.HandGrab.DistanceHandGrabInteractable>(true);\n var fieldFlags=System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic;\n var pointField=direct.GetType().BaseType.GetField(\"_pointableElement\",fieldFlags);\n var handPointField=hand.GetType().BaseType.GetField(\"_pointableElement\",fieldFlags);\n var distancePointField=distance.GetType().BaseType.GetField(\"_pointableElement\",fieldFlags);\n var distanceHandPointField=distanceHand.GetType().BaseType.GetField(\"_pointableElement\",fieldFlags);\n sb.AppendLine(root.name+\" tag=\"+root.tag+\" directPoint=\"+(pointField.GetValue(direct)==gr)+\" handPoint=\"+(handPointField.GetValue(hand)==gr)+\" distancePoint=\"+(distancePointField.GetValue(distance)==gr)+\" distanceHandPoint=\"+(distanceHandPointField.GetValue(distanceHand)==gr));\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}

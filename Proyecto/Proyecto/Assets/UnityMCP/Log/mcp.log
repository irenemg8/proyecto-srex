{"ts":"2026-11-16T17:02:46.367Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3507,"action":"execute","params":{"action":"execute","code":"\nvar sb=new System.Text.StringBuilder();\nsb.AppendLine(\"playing=\"+Application.isPlaying);\nforeach(UnityEngine.Transform f in GameObject.Find(\"FRUTAS\").transform){\n var gr=f.GetComponent<Oculus.Interaction.Grabbable>();\n var rb=f.GetComponent<UnityEngine.Rigidbody>();\n var direct=f.GetComponent<Oculus.Interaction.GrabInteractable>();\n var hand=f.GetComponent<Oculus.Interaction.HandGrab.HandGrabInteractable>();\n var d=f.Find(\"DistanceHandGrabInstallationRoutine\");\n var dg=d.GetComponent<Oculus.Interaction.DistanceGrabInteractable>();\n var dh=d.GetComponent<Oculus.Interaction.HandGrab.DistanceHandGrabInteractable>();\n int providers=0;string providerTypes=\"\";\n foreach(var c in d.GetComponents<UnityEngine.Component>())if(c!=null&&c.GetType().Name.Contains(\"MoveTowardsTargetProvider\")){providers++;providerTypes+=c.GetType().Name+\",\";}\n sb.AppendLine(f.name+\" pointable=\"+(direct.PointableElement==gr)+\"/\"+(hand.PointableElement==gr)+\"/\"+(dg.PointableElement==gr)+\"/\"+(dh.PointableElement==gr)+\" rb=\"+(dg.Rigidbody==rb&&dh.Rigidbody==rb)+\" colliders=\"+(dg.Colliders==null?0:dg.Colliders.Length)+\"/\"+(dh.Colliders==null?0:dh.Colliders.Length)+\" providers=\"+providers+\" \"+providerTypes);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}

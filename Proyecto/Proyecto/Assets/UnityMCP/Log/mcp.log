{"ts":"2026-11-26T09:11:48.120Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3803,"action":"execute","params":{"action":"execute","code":"var dd = UnityEngine.Object.FindAnyObjectByType<TMPro.TMP_Dropdown>();\nif (dd == null || dd.template == null) return \"missing\";\nvar lists = UnityEngine.Object.FindObjectsByType<Transform>(FindObjectsInactive.Include, FindObjectsSortMode.None);\nint n = 0;\nfor (int i = 0; i < lists.Length; i++) if (lists[i].name == \"Dropdown List\") n++;\nreturn \"playing=\" + UnityEditor.EditorApplication.isPlaying + \" templateActive=\" + dd.template.gameObject.activeSelf + \" leftoverLists=\" + n;","safety_checks":true,"compiler":"codedom"}}

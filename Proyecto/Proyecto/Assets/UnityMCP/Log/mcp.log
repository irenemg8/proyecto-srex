{"ts":"2026-11-16T19:44:28.387Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3069,"action":"execute","params":{"action":"execute","code":"\nvar targets=new[]{\"SARTEN/SartenSensor\",\"Panel_Alimentos\",\"INTERFACES\",\"Panel_Volumen\",\"Panel_Locomocion\",\"Toggle_EfectosEspaciales\",\"ButtonShelf_IconAndLabel_Toggle\"};\nvar sb=new System.Text.StringBuilder();\nforeach(string path in targets){\n var go=GameObject.Find(path);\n sb.AppendLine(path+\": \"+(go==null?\"missing\":string.Join(\",\",System.Array.ConvertAll(go.GetComponents<Component>(),c=>c==null?\"Missing\":c.GetType().Name))));\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}

{"ts":"2026-11-16T16:08:19.185Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3226,"action":"execute","params":{"action":"execute","code":"\nvar sb = new System.Text.StringBuilder();\nstring[] typeNames={\"Oculus.Interaction.GrabInteractable\",\"Oculus.Interaction.Grabbable\",\"Oculus.Interaction.HandGrab.HandGrabInteractable\",\"Oculus.Interaction.Locomotion.MovingSetting\"};\nforeach(string tn in typeNames){\n Type t=null; foreach(var a in System.AppDomain.CurrentDomain.GetAssemblies()){t=a.GetType(tn,false);if(t!=null)break;}\n sb.AppendLine(\"=== \"+tn+\" ===\");\n if(t==null){sb.AppendLine(\"type missing\");continue;}\n foreach(var f in t.GetFields(System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.NonPublic|System.Reflection.BindingFlags.DeclaredOnly)){\n   sb.AppendLine(f.Name+\" : \"+f.FieldType.FullName+\" serialized=\"+(System.Attribute.IsDefined(f,typeof(UnityEngine.SerializeField))));\n }\n}\nvar ms=GameObject.Find(\"Moving\").GetComponent<Oculus.Interaction.Locomotion.MovingSetting>();\nsb.AppendLine(\"=== MovingSetting current ===\");\nvar mtype=ms.GetType();\nforeach(string fieldName in new[]{\"_slideGameObjects\",\"_teleportGameObjects\"}){\n var fi=mtype.GetField(fieldName,System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic);\n if(fi==null){sb.AppendLine(fieldName+\" missing\");continue;}\n var val=fi.GetValue(ms) as System.Collections.IEnumerable;\n sb.Append(fieldName+\": \");\n if(val!=null)foreach(var item in val)sb.Append(item is GameObject g?g.name:item?.ToString()).Append(\"|\");\n sb.AppendLine();\n}\nsb.AppendLine(\"=== UI controls ===\");\nforeach(var go in UnityEngine.Object.FindObjectsOfType<GameObject>(true)){\n var btn=go.GetComponent<UnityEngine.UI.Button>();\n var tog=go.GetComponent<UnityEngine.UI.Toggle>();\n if(btn!=null||tog!=null){\n  var tx=go.GetComponentInChildren<TMPro.TMP_Text>(true);\n  sb.Append(go.name+\" Button=\"+(btn!=null)+\" Toggle=\"+(tog!=null)+\" value=\"+(tog==null?\"-\":tog.isOn.ToString())+\" TMP=\"+(tx==null?\"\":tx.text)+\" clickListeners=\"+(btn==null?\"-\":btn.onClick.GetPersistentEventCount().ToString())).AppendLine();\n }\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}

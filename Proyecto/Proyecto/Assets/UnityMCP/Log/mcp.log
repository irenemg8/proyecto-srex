{"ts":"2026-11-16T17:10:35.113Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3447,"action":"execute","params":{"action":"execute","code":"\nvar sb=new System.Text.StringBuilder();\nvar rig=GameObject.Find(\"[BuildingBlock] Camera Rig\");\nforeach(var c in rig.GetComponentsInChildren<UnityEngine.Component>(true)){\n if(c!=null&&(c.GetType().Name==\"DistanceGrabInteractor\"||c.GetType().Name==\"DistanceHandGrabInteractor\")){\n  var prop=c.GetType().GetProperty(\"SelectedInteractable\",System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.Instance);\n  var selected=prop==null?null:prop.GetValue(c,null);\n  sb.AppendLine(c.gameObject.name+\" \"+c.GetType().Name+\" active=\"+c.gameObject.activeInHierarchy+\" selected=\"+(selected==null?\"none\":selected.ToString()));\n }\n}\nvar f=GameObject.Find(\"FRUTAS/Banana_01\");\nvar g=f.GetComponent<Oculus.Interaction.Grabbable>();\nvar rb=f.GetComponent<UnityEngine.Rigidbody>();\nvar near=f.GetComponent<Oculus.Interaction.GrabInteractable>();\nvar far=f.transform.Find(\"DistanceHandGrabInstallationRoutine\").GetComponent<Oculus.Interaction.DistanceGrabInteractable>();\nvar provider=f.transform.Find(\"DistanceHandGrabInstallationRoutine\").GetComponent<Oculus.Interaction.MoveTowardsTargetProvider>();\nsb.AppendLine(\"Banana_01 running: nearPointable=\"+(near.PointableElement==g)+\" farPointable=\"+(far.PointableElement==g)+\" farColliders=\"+far.Colliders.Length+\" provider=\"+(provider!=null)+\" gravity=\"+rb.useGravity);\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
{"ts":"2026-11-16T17:11:01.930Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3278,"action":"execute","params":{"action":"execute","code":"\nvar sb=new System.Text.StringBuilder();\nvar moving=GameObject.Find(\"Moving\").GetComponent<Oculus.Interaction.Locomotion.MovingSetting>();\nvar flags=System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic;\nforeach(string n in new[]{\"_slideGameObjects\",\"_teleportGameObjects\"}){\n var f=moving.GetType().GetField(n,flags);\n var list=(System.Collections.Generic.List<UnityEngine.GameObject>)f.GetValue(moving);\n sb.AppendLine(n+\":\");\n foreach(var g in list)if(g!=null){\n  sb.Append(\"  \").Append(g.name).Append(\" self=\").Append(g.activeSelf).Append(\" activeHierarchy=\").Append(g.activeInHierarchy).Append(\" parent=\").Append(g.transform.parent==null?\"null\":g.transform.parent.name).AppendLine();\n }\n}\nforeach(var go in UnityEngine.Object.FindObjectsOfType<UnityEngine.GameObject>(true)){\n if(go.name==\"DistanceHandGrabInteractor\"||go.name==\"DistanceControllerHandGrabInteractor\"||go.name==\"HandGrabInteractor\"||go.name==\"ControllerDistanceGrabInteractor\"){\n  string path=go.name; var t=go.transform.parent;\n  while(t!=null){path=t.name+\"/\"+path;t=t.parent;}\n  sb.AppendLine(\"INTERACTOR \"+path+\" self=\"+go.activeSelf+\" inHierarchy=\"+go.activeInHierarchy);\n }\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}

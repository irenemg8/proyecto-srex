{"ts":"2026-11-26T09:10:36.789Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":4283,"action":"execute","params":{"action":"execute","code":"var dd = UnityEngine.Object.FindAnyObjectByType<TMPro.TMP_Dropdown>();\nvar list = UnityEngine.Object.FindObjectsByType<RectTransform>(FindObjectsInactive.Include, FindObjectsSortMode.None);\nRectTransform found = null;\nfor (int i = 0; i < list.Length; i++) if (list[i].name == \"Dropdown List\") { found = list[i]; break; }\nif (found == null) return \"list missing expanded=\" + (dd != null && dd.IsExpanded);\nvar path = found.name;\nvar p = found.parent;\nwhile (p != null) { path = p.name + \"/\" + path; p = p.parent; }\nvar le = found.GetComponent<UnityEngine.UI.LayoutElement>();\nvar graphics = found.GetComponentsInChildren<UnityEngine.UI.MaskableGraphic>(true);\nint masked = 0;\nfor (int i = 0; i < graphics.Length; i++) if (graphics[i].maskable) masked++;\nvar texts = found.GetComponentsInChildren<TMPro.TMP_Text>(true);\nvar names = new System.Collections.Generic.List<string>();\nfor (int i = 0; i < texts.Length; i++) {\n  if (texts[i].name == \"Item Label\" && texts[i].gameObject.activeInHierarchy)\n    names.Add(texts[i].text);\n}\nreturn path + \" rect=\" + found.rect.width.ToString(\"0\") + \"x\" + found.rect.height.ToString(\"0\") + \" ignore=\" + (le != null && le.ignoreLayout) + \" stillMasked=\" + masked + \"/\" + graphics.Length + \" opts=\" + string.Join(\" | \", names.ToArray());","safety_checks":true,"compiler":"codedom"}}

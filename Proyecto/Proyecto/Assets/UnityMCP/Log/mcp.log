{"ts":"2026-11-16T17:13:54.008Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3073,"action":"execute","params":{"action":"execute","code":"\nvar sb=new System.Text.StringBuilder();\nforeach(var go in UnityEngine.Object.FindObjectsOfType<UnityEngine.GameObject>(true)){\n if(go.name==\"ControllerDistanceGrabInteractor\"||go.name==\"ControllerGrabInteractor\"){\n  UnityEngine.Component interactor=go.GetComponent<Oculus.Interaction.DistanceGrabInteractor>();\n  if(interactor==null)interactor=go.GetComponent<Oculus.Interaction.GrabInteractor>();\n  if(interactor==null)continue;\n  var f=interactor.GetType().GetField(\"_selector\",System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic);\n  var s=f==null?null:f.GetValue(interactor);\n  sb.AppendLine(go.name+\" selector=\"+(s==null?\"null\":s.GetType().Name+\" on \"+((UnityEngine.Component)s).gameObject.name));\n  var cs=s as Oculus.Interaction.ControllerSelector;\n  if(cs!=null)sb.AppendLine(\"  usages=\"+cs.ControllerButtonUsage+\" required=\"+cs.RequireButtonUsages);\n }\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}
{"ts":"2026-11-16T17:14:14.491Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3077,"action":"execute","params":{"action":"execute","code":"\nvar sb=new System.Text.StringBuilder();\nstring[] paths={\"Assets/_Proyecto/Prefabs/Frutas/Banana_Interactable.prefab\",\"Assets/_Proyecto/Prefabs/Frutas/Orange_Interactable.prefab\",\"Assets/_Proyecto/Prefabs/Frutas/Pineapple_Interactable.prefab\"};\nvar flags=System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic;\nforeach(string path in paths){\n var root=UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.GameObject>(path);\n var gr=root.GetComponent<Oculus.Interaction.Grabbable>();\n var child=root.transform.Find(\"DistanceHandGrabInstallationRoutine\");\n var direct=root.GetComponent<Oculus.Interaction.GrabInteractable>();\n var hand=root.GetComponent<Oculus.Interaction.HandGrab.HandGrabInteractable>();\n var dg=child.GetComponent<Oculus.Interaction.DistanceGrabInteractable>();\n var dh=child.GetComponent<Oculus.Interaction.HandGrab.DistanceHandGrabInteractable>();\n var provider=child.GetComponent<Oculus.Interaction.MoveTowardsTargetProvider>();\n var baseType=direct.GetType().BaseType;\n var fieldsOk=baseType.GetField(\"_pointableElement\",flags).GetValue(direct)==gr &&\n  hand.GetType().BaseType.GetField(\"_pointableElement\",flags).GetValue(hand)==gr &&\n  dg.GetType().BaseType.GetField(\"_pointableElement\",flags).GetValue(dg)==gr &&\n  dh.GetType().BaseType.GetField(\"_pointableElement\",flags).GetValue(dh)==gr;\n var movementOk=dg.GetType().GetField(\"_movementProvider\",flags).GetValue(dg)==provider &&\n  dh.GetType().GetField(\"_movementProvider\",flags).GetValue(dh)==provider;\n sb.AppendLine(root.name+\" near+far Grabbable refs=\"+fieldsOk+\" sharedMovementProvider=\"+movementOk+\" colliders=\"+root.GetComponents<UnityEngine.Collider>().Length);\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}

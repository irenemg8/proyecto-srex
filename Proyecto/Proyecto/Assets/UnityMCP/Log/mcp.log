ctiveSlide=0;activeTeleport=0;\nforeach(GameObject g in (System.Collections.Generic.List<GameObject>)sf.GetValue(ms))if(g!=null&&g.activeSelf)activeSlide++;\nforeach(GameObject g in (System.Collections.Generic.List<GameObject>)tf.GetValue(ms))if(g!=null&&g.activeSelf)activeTeleport++;\nsb.AppendLine(\"slide mode active group refs=\"+activeSlide+\"/\"+activeTeleport);\n\nstring[] fruitNames={\"Banana_01\",\"Banana_02\",\"Orange_01\",\"Orange_02\",\"Pineapple_01\"};\nforeach(string n in fruitNames){\n var go=GameObject.Find(\"FRUTAS/\"+n);\n if(go==null){sb.AppendLine(\"MISSING \"+n);continue;}\n controller.SendMessage(\"OnTriggerEnter\",go.GetComponent<Collider>());\n}\ncontroller.RefreshProgressUI();\nvar s1=GameObject.Find(\"Panel_Ingrediente_3/Text_Cantidad\").GetComponent<TMPro.TMP_Text>().text;\nvar s2=GameObject.Find(\"Panel_Ingrediente_2/Text_Cantidad\").GetComponent<TMPro.TMP_Text>().text;\nvar s3=GameObject.Find(\"Panel_Ingrediente_1/Text_Cantidad\").GetComponent<TMPro.TMP_Text>().text;\nvar status=GameObject.Find(\"Text_Estado\").GetComponent<TMPro.TMP_Text>().text;\nsb.AppendLine(\"after delivery counters=\"+s1+\",\"+s2+\",\"+s3+\" status=\"+status);\nsb.AppendLine(\"audio restored=\"+(!wc.mute&&!panAudio.mute&&!frying.mute)+\" ambient2D=\"+!ambient.mute+\" ambientVolume=\"+ambient.volume);\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}

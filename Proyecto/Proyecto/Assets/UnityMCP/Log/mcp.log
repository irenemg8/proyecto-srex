{"ts":"2026-11-16T16:37:40.943Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3666,"action":"execute","params":{"action":"execute","code":"\nvar sb=new System.Text.StringBuilder();\nvar pan=GameObject.Find(\"SARTEN/sarten\");\nvar sensor=GameObject.Find(\"SARTEN/SartenSensor\");\nsb.AppendLine(\"Scene sensor=\"+(sensor!=null)+\" controller=\"+(sensor!=null&&sensor.GetComponent<SrexKitchenController>()!=null));\nforeach(var c in pan.GetComponents<Collider>())sb.AppendLine(\"Pan physical \"+c.GetType().Name+\" trigger=\"+c.isTrigger);\nvar trigger=sensor.GetComponent<BoxCollider>();\nsb.AppendLine(\"Sensor trigger=\"+trigger.isTrigger+\" worldSize=\"+trigger.bounds.size);\nvar fruits=GameObject.Find(\"FRUTAS\");\nforeach(UnityEngine.Transform f in fruits.transform){\n var gi=f.GetComponent<Oculus.Interaction.GrabInteractable>();\n var gr=f.GetComponent<Oculus.Interaction.Grabbable>();\n var hi=f.GetComponent<Oculus.Interaction.HandGrab.HandGrabInteractable>();\n var rb=f.GetComponent<Rigidbody>();\n sb.AppendLine(f.name+\" [\"+f.tag+\"] RB=\"+rb.useGravity+\"/\"+rb.isKinematic+\" colliders=\"+f.GetComponents<Collider>().Length+\" grab=\"+(gi!=null)+\" grabbable=\"+(gr!=null)+\" hand=\"+(hi!=null)+\" prefab=\"+UnityEditor.PrefabUtility.GetPrefabAssetPathOfNearestInstanceRoot(f.gameObject));\n}\nforeach(string p in new[]{\"Panel_Ingrediente_3\",\"Panel_Ingrediente_2\",\"Panel_Ingrediente_1\"}){\n var panel=GameObject.Find(p);sb.AppendLine(p+\"=\"+panel.transform.Find(\"Text_Cantidad\").GetComponent<TMPro.TMP_Text>().text);\n}\nsb.AppendLine(\"Exit=\"+GameObject.Find(\"Text_Estado\").GetComponent<TMPro.TMP_Text>().text);\nsb.AppendLine(\"EffectsToggle=\"+GameObject.Find(\"Toggle_EfectosEspaciales\").GetComponent<UnityEngine.UI.Toggle>().isOn);\nvar parent=GameObject.Find(\"Panel_Ajustes\").GetComponent<UnityEngine.RectTransform>();\nvar vol=GameObject.Find(\"Panel_Volumen\").GetComponent<UnityEngine.RectTransform>();\nvar check=GameObject.Find(\"Toggle_EfectosEspaciales/Checkbox\").GetComponent<UnityEngine.RectTransform>();\nfloat vx=parent.InverseTransformPoint(vol.TransformPoint(new UnityEngine.Vector3(vol.rect.xMin,0f,0f))).x;\nfloat cx=parent.InverseTransformPoint(check.TransformPoint(new UnityEngine.Vector3(check.rect.xMin,0f,0f))).x;\nsb.AppendLine(\"Volume/checkbox aligned X delta=\"+(cx-vx).ToString(\"F2\"));\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}

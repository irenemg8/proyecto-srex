{"ts":"2026-11-16T15:30:50.843Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3154,"action":"execute","params":{"action":"execute","code":"\nvar sb = new System.Text.StringBuilder();\nFunc<string, Vector3, Vector3, string> sweep = (label, from, to) => {\n  var dir = (to - from).normalized; float dist = Vector3.Distance(from, to);\n  var p1 = from + new Vector3(0, 0.26f, 0); var p2 = from + new Vector3(0, 1.15f, 0);\n  var hits = Physics.CapsuleCastAll(p1, p2, 0.25f, dir, dist);\n  var real = hits.Where(h => !h.collider.isTrigger).OrderBy(h=>h.distance).ToList();\n  real = real.Where(h => h.point.y > 0.02f).ToList();\n  return label + (real.Count == 0 ? \" => CLEAR\" : \" => BLOCKED: \" + string.Join(\" | \", real.Select(h=>h.collider.transform.name + \"@\" + h.distance.ToString(\"F2\"))));\n};\nsb.AppendLine(sweep(\"Exterior door IN \", new Vector3(7.2f,0f,0f), new Vector3(4.7f,0f,0f)));\nsb.AppendLine(sweep(\"Exterior door OUT\", new Vector3(4.8f,0f,0f), new Vector3(7.0f,0f,0f)));\nsb.AppendLine(sweep(\"Bedroom door IN  \", new Vector3(-0.6f,0f,0.3f), new Vector3(-0.6f,0f,1.7f)));\nsb.AppendLine(sweep(\"Bathroom door IN \", new Vector3(1.26f,0f,-2.1f), new Vector3(1.26f,0f,-0.3f)));\nsb.AppendLine(sweep(\"Kitchen door IN  \", new Vector3(-3.97f,0f,-2.1f), new Vector3(-3.97f,0f,-0.3f)));\nsb.AppendLine(sweep(\"Living arch IN   \", new Vector3(3.35f,0f,0.3f), new Vector3(3.35f,0f,1.7f)));\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"}}

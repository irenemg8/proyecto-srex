    var pinchIndex = ruleType.GetField(\"_indexRequirement\",System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic);\n    var palmThumb = ruleType.GetField(\"_thumbRequirement\",System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic);\n    var palmIndex = ruleType.GetField(\"_indexRequirement\",System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic);\n    pinchThumb.SetValue(pinch,System.Enum.ToObject(pinchThumb.FieldType,2));\n    pinchIndex.SetValue(pinch,System.Enum.ToObject(pinchIndex.FieldType,2));\n    palmThumb.SetValue(palm,System.Enum.ToObject(palmThumb.FieldType,1));\n    palmIndex.SetValue(palm,System.Enum.ToObject(palmIndex.FieldType,2));\n    var inject = handGrab.GetType().GetMethod(\"InjectAllHandGrabInteractable\");\n    var parameters = inject.GetParameters();\n    inject.Invoke(handGrab,new object[]{System.Enum.ToObject(parameters[0].ParameterType,3),body,pinch,palm});\n    var handCollidersField = handGrab.GetType().GetField(\"<Colliders>k__BackingField\",System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic);\n    if (handCollidersField != null) handCollidersField.SetValue(handGrab,colliders);\n\n    configured++;\n    sb.AppendLine(fruit.name+\" tag=\"+fruit.tag+\" RB=\"+(body!=null)+\" colliderCount=\"+colliders.Length+\" Grab=\"+(grab!=null)+\" Grabbable=\"+(grabbable!=null)+\" HandGrab=\"+(handGrab!=null));\n}\nreturn \"Configured Meta XR grab components on \"+configured+\" fruit objects\\n\"+sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}

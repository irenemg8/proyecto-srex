{"ts":"2026-11-16T16:17:17.058Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3077,"action":"execute","params":{"action":"execute","code":"\nvar sb=new System.Text.StringBuilder();\nvar root=GameObject.Find(\"SARTEN\");\nvar pan=GameObject.Find(\"SARTEN/sarten\");\nif(root==null||pan==null)return \"BLOCKED: pan hierarchy missing\";\nvar b=pan.GetComponent<MeshCollider>().bounds;\nvar center=new UnityEngine.Vector3(b.center.x,b.max.y+0.04f,b.center.z);\nvar oldController=pan.GetComponent<SrexKitchenController>();\nvar sensorTransform=root.transform.Find(\"SartenSensor\");\nGameObject sensor;\nif(sensorTransform==null){\n sensor=new GameObject(\"SartenSensor\",typeof(UnityEngine.BoxCollider));\n sensor.transform.SetParent(root.transform,false);\n}else sensor=sensorTransform.gameObject;\nsensor.transform.SetPositionAndRotation(center,UnityEngine.Quaternion.identity);\nsensor.transform.localScale=UnityEngine.Vector3.one;\nvar box=sensor.GetComponent<UnityEngine.BoxCollider>();\nif(box==null)box=sensor.AddComponent<UnityEngine.BoxCollider>();\nbox.isTrigger=true;\nbox.size=new UnityEngine.Vector3(b.size.x*0.82f,0.10f,b.size.z*0.78f);\nbox.center=UnityEngine.Vector3.zero;\nif(sensor.GetComponent<SrexKitchenController>()==null)sensor.AddComponent<SrexKitchenController>();\nif(oldController!=null)UnityEngine.Object.DestroyImmediate(oldController);\nforeach(var old in pan.GetComponents<UnityEngine.BoxCollider>())if(old.isTrigger)UnityEngine.Object.DestroyImmediate(old);\nsb.AppendLine(\"Moved game controller to SARTEN/SartenSensor\");\nsb.AppendLine(\"Sensor center=\"+sensor.transform.position+\" size=\"+box.bounds.size+\" trigger=\"+box.isTrigger);\nreturn sb.ToString();\n","safety_checks":true,"compiler":"codedom"}}

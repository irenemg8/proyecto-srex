{"ts":"2026-11-16T15:24:32.535Z","tool":"execute_code","type":"tool","status":"ERROR","ms":3065,"action":"execute","params":{"action":"execute","code":"\nvar sb = new System.Text.StringBuilder();\n// Map door openings: for each door, sample horizontal positions across the door width at y=1.0 and y=0.3,\n// shooting a ray along the crossing direction; report free slots.\nFunc<string, Vector3, Vector3, string, string> map = (label, baseP, dir, axisName) => {\n  var r = new System.Text.StringBuilder();\n  r.AppendLine(\"--- \" + label + \" (crossing \" + axisName + \", dir=\" + dir + \") ---\");\n  for (int i = -5; i <= 5; i++) {\n    float off = i * 0.1f;\n    foreach (var y in new[]{0.3f, 1.0f}) {\n      var p = baseP + (axisName==\"z\" ? new Vector3(0,0,off) : new Vector3(off,0,0));\n      var hits = Physics.RaycastAll(p, dir, 3f).Where(h=>!h.collider.isTrigger).OrderBy(h=>h.distance).ToList();\n      var wallHit = hits.FirstOrDefault(h=>h.collider.transform.name.Contains(\"Room\") || h.collider.transform.name.Contains(\"Door\"));\n      r.Append(wallHit != null ? \"#\" : \".\");\n    }\n    r.Append(\" (offset \" + (off >= 0 ? \"+\" : \"\") + off.ToString(\"F1\") + \")\\n\");\n  }\n  return r.ToString();\n};\n// doorset001: exterior door on +X side at z=0. Wall plane x≈5.97. Cross along X at z offsets.\nsb.Append(map(\"DOOR001 exterior\", new Vector3(8f, 0f, 0f), new Vector3(-1,0,0), \"z\"));\n// doorset002: opening along Z at x=-0.55, wall plane z≈0.9. Cross along Z at x offsets.\nsb.Append(map(\"DOOR002\", new Vector3(-0.55f, 0f, -3f), new Vector3(0,0,1), \"x\"));\nsb.Append(map(\"DOOR003\", new Vector3(1.26f, 0f, -3f), new Vector3(0,0,1), \"x\"));\nsb.Append(map(\"DOOR004\", new Vector3(-3.97f, 0f, -3f), new Vector3(0,0,1), \"x\"));\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"},"error":"Compilation failed"}
